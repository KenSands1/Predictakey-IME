<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pref_direction_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/direction_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/direction_ltr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_direction_ltr" />

        <RadioButton
            android:id="@+id/direction_rtl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_direction_rtl" />
    </RadioGroup>

    <Button
        android:id="@+id/open_keyboard_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Enable / choose keyboard" />

</LinearLayout>
